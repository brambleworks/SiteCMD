{
  "name": "@sitecmd/desktop",
  "private": true,
  "version": "1.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "dev:tauri": "vite --host localhost",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "perf:baseline": "SITECMD_PERF_BASELINE=1 vitest run src/main.performance.test.tsx src/hooks/useProject.performance.test.tsx src/lib/performance-baseline.capture.test.tsx",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build:debug": "tauri build --debug",
    "tauri:build:release": "tauri build",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:push": "vitest run src/App.render.test.tsx src/components/checklist src/lib/project-nav-badges.test.ts src/lib/project-selection-state.test.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:debug": "playwright test --debug",
    "size": "node ../../tools/scripts/check-eager-bundle-parity.mjs && size-limit",
    "size:why": "size-limit --why",
    "cov:rust": "cd src-tauri && cargo llvm-cov nextest --no-fail-fast --summary-only",
    "cov:rust:html": "cd src-tauri && cargo llvm-cov nextest --no-fail-fast --html --open",
    "cov:rust:lcov": "cd src-tauri && cargo llvm-cov nextest --no-fail-fast --lcov --output-path lcov.info"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-pdf/renderer": "^4.6.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "~2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-store": "^2.4.4",
    "clsx": "^2.1.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "react-scan": "^0.5.7",
    "size-limit": "^13.0.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
