[
  {
    "name": "Initial page (the whole static graph loaded before first UI paint: the hand-linked boot stylesheet, the entry chunk, the App bootstrap chunk, everything they statically import, and the app stylesheet)",
    "path": [
      "dist/boot.css",
      "dist/assets/index-*.js",
      "dist/assets/rolldown-runtime-*.js",
      "dist/assets/vendor-react-*.js",
      "dist/assets/vendor-tauri-*.js",
      "dist/assets/vendor-icons-*.js",
      "dist/assets/commands-*.js",
      "dist/assets/format-*.js",
      "dist/assets/severity-*.js",
      "dist/assets/store-*.js",
      "dist/assets/action-language-*.js",
      "dist/assets/app-events-*.js",
      "dist/assets/app-targets-*.js",
      "dist/assets/observability-*.js",
      "dist/assets/open-url-*.js",
      "dist/assets/project-issue-summary-*.js",
      "dist/assets/skeleton-*.js",
      "dist/assets/tokens-*.js",
      "dist/assets/utils-*.js",
      "dist/assets/PageGuide-*.js",
      "dist/assets/App-*.js",
      "dist/assets/index-*.css",
      "!dist/assets/vendor-react-pdf-*.js"
    ],
    "limit": "206 kB",
    "gzip": true
  },
  {
    "name": "Total app JS (excluding lazy pdf renderer)",
    "path": ["dist/assets/*.js", "!dist/assets/vendor-react-pdf-core-*.js"],
    "limit": "615 kB",
    "gzip": true
  },
  {
    "name": "Dossier rail lazy chunk",
    "path": "dist/assets/DossierRailDetails-*.js",
    "limit": "10 kB",
    "gzip": true
  },
  {
    "name": "PDF renderer chunk (lazy)",
    "path": "dist/assets/vendor-react-pdf-core-*.js",
    "limit": "500 kB",
    "gzip": true
  },
  {
    "name": "Issue action bar lazy chunk (markdown renderer excluded)",
    "path": "dist/assets/IssueActionBar-*.js",
    "limit": "7 kB",
    "gzip": true
  },
  {
    "name": "Markdown renderer lazy chunk (react-markdown and rehype, no grammars)",
    "path": "dist/assets/markdown-renderer-*.js",
    "limit": "94 kB",
    "gzip": true
  }
]
