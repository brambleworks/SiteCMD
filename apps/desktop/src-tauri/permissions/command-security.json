    "sitecmd-project-execution"
  ],
  "brokeredMainWindowCommands": {
    "sitecmd-data-admin": {
      "brokerCommand": "run_data_admin_command",
      "capability": "apps/desktop/src-tauri/capabilities/data-admin.json",
      "frontendBroker": "apps/desktop/src/lib/tauri-invoke.ts",
      "privilegedBridge": "apps/desktop/src/lib/privileged-command-bridge.ts",
      "bridgeWindow": "data-admin",
      "mainWindowBrokerGrant": false,
      "rationale": "The main window must not receive the direct data-admin permission. Destructive data operations are routed through a data-admin-only Rust broker that validates the requested command, preserves native confirmation, and rejects commands from other elevated scopes.",
      "directMainWindowGrant": false
    },
    "sitecmd-filesystem-export": {
      "brokerCommand": "run_filesystem_export_command",
      "capability": "apps/desktop/src-tauri/capabilities/filesystem-export.json",
      "frontendBroker": "apps/desktop/src/lib/tauri-invoke.ts",
      "privilegedBridge": "apps/desktop/src/lib/privileged-command-bridge.ts",
      "bridgeWindow": "filesystem-export",
      "mainWindowBrokerGrant": false,
      "rationale": "The main window must not receive direct filesystem export/write permission. Export writes and database backups are routed through a filesystem-export-only Rust broker so path validation and native overwrite/export confirmations stay server-side.",
      "directMainWindowGrant": false
    },
    "sitecmd-external-connectors": {
      "brokerCommand": "run_external_connector_command",
      "capability": "apps/desktop/src-tauri/capabilities/external-connectors.json",
      "frontendBroker": "apps/desktop/src/lib/tauri-invoke.ts",
      "privilegedBridge": "apps/desktop/src/lib/privileged-command-bridge.ts",
      "bridgeWindow": "external-connectors",
      "mainWindowBrokerGrant": false,
      "rationale": "The main window must not receive direct connector, OAuth, webhook, update, or licensing broker permissions. These commands are routed through an external-connector-only bridge window so credential handling, feature gates, and network validation stay server-side and off the most exposed renderer.",
      "directMainWindowGrant": false
    },
    "sitecmd-filesystem-access": {
      "brokerCommand": "run_filesystem_access_command",
      "capability": "apps/desktop/src-tauri/capabilities/filesystem-access.json",
      "frontendBroker": "apps/desktop/src/lib/tauri-invoke.ts",
      "privilegedBridge": "apps/desktop/src/lib/privileged-command-bridge.ts",
      "bridgeWindow": "filesystem-access",
      "mainWindowBrokerGrant": false,
      "rationale": "The main window must not receive direct local filesystem/project access broker permissions. Code scans, path resolution, log reads, editor opens, and reveal actions are routed through a filesystem-access-only bridge window so registered-project validation remains server-side and off the most exposed renderer.",
      "directMainWindowGrant": false
    },
    "sitecmd-project-execution": {
      "brokerCommand": "run_project_execution_command",
      "capability": "apps/desktop/src-tauri/capabilities/project-execution.json",
      "frontendBroker": "apps/desktop/src/lib/tauri-invoke.ts",
      "privilegedBridge": "apps/desktop/src/lib/privileged-command-bridge.ts",
      "bridgeWindow": "project-execution",
      "mainWindowBrokerGrant": false,
      "rationale": "The main window must not receive direct project command execution permission. Project commands are routed through a project-execution-only Rust broker so executable validation and native confirmation stay server-side before any process starts.",
      "directMainWindowGrant": false
    }
  },
  "mainWindowElevatedCapabilityBudget": {
    "max": 0,
    "target": 0,
    "targetPlan": "The main window must keep a zero elevated direct-permission budget. Feature-scoped elevated brokers execute through hidden privileged bridge windows. Main may only request command-family-scoped one-time tokens; it must not receive a shared sensitive-token issuer that can mint tokens across multiple elevated families. Destructive, filesystem-writing, and project-execution commands still require native confirmation or a user-intent proof before execution."
  },
