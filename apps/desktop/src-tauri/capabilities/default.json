{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables baseline SiteCMD app permissions",
  "windows": ["main"],
  "permissions": [
    "default",
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "core:menu:default",
    "core:tray:default",
    "notification:default",
    "deep-link:default",
    "window-state:default",
    "process:allow-restart",
    "os:default",
    "clipboard-manager:allow-write-text",
    "store:allow-load",
    "store:allow-get",
    "store:allow-set",
    "store:allow-save",
    "global-shortcut:default",
    "autostart:default"
  ]
}
