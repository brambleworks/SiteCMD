destroy table inet sitecmd_benchmark
table inet sitecmd_benchmark {
  counter private_egress_denied {}
  chain input {
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state established,related accept
    tcp dport 22 accept
    udp sport 67 udp dport 68 accept
  }
  chain output {
    type filter hook output priority 0; policy drop;
    oifname "lo" accept
    ct state established,related accept
    ip daddr 192.168.5.2 udp dport 53 accept
    ip daddr 192.168.5.2 tcp dport 53 accept
    udp sport 68 udp dport 67 accept
    meta nfproto ipv6 reject
    ip daddr {
      0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
      169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16,
      198.18.0.0/15, 224.0.0.0/4, 240.0.0.0/4
    } counter name private_egress_denied reject
    tcp dport { 80, 443 } accept
    udp dport { 53, 123 } accept
  }
}
